@model Picklr.Models.PicklProgram

@{
    ViewBag.Title = ViewBag.Action + " Program";
    var clubs = ViewBag.Clubs as List<Picklr.Models.Club>;
}

<h1>@ViewBag.Action Program</h1>

<form asp-action="AddEdit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="ProgramID" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fee" class="form-label"></label>
        <input asp-for="Fee" class="form-control" />
        <span asp-validation-for="Fee" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ClubID" class="form-label"></label>
        <select asp-for="ClubID" class="form-select">
            <option value="0">-- Select a club --</option>
            @if (clubs != null)
            {
                foreach (var c in clubs)
                {
                    <option value="@c.ClubID">@c.Name</option>
                }
            }
        </select>
        <span asp-validation-for="ClubID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Available Days</label>
        <div>
            @foreach (Picklr.Models.Weekdays day in Enum.GetValues(typeof(Picklr.Models.Weekdays)))
            {
                @if (Convert.ToInt32(day) != 0)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"
                               name="AvailableDays" value="@day"
                               id="day_@day"
                               checked="@(Model.AvailableDays.HasFlag(day))" />
                        <label class="form-check-label" for="day_@day">@day</label>
                    </div>
                }
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">@ViewBag.Action</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}